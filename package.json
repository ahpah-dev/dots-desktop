{
  "name": "dots-desktop",
  "productName": "Dots",
  "version": "2.1.5",
  "description": "Persistent, autonomous AI agents (Dots) with their own workspace, memory, tools and schedules.",
  "main": "dist/main/index.js",
  "author": "Dots",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "npm run typecheck && npm run build:main && npm run build:renderer",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "test:smoke": "node scripts/smoke-test.mjs",
    "test:messages": "node scripts/message-smoke.mjs",
    "test:motion": "node scripts/motion-smoke.mjs",
    "test:accessories": "node scripts/accessory-smoke.mjs",
    "test:desktop-dot": "node scripts/desktop-dot-smoke.mjs",
    "test:dot-messaging": "node scripts/dot-messaging-smoke.mjs",
    "dist": "npm run build && electron-builder",
    "dist:dir": "npm run build && electron-builder --dir",
    "media:capture": "node scripts/capture-demo.mjs",
    "media:render": "node scripts/render-promo.mjs",
    "test:website": "node scripts/test-website.mjs",
    "test:teamwork": "node scripts/teamwork-smoke.mjs"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.10",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0",
    "ffmpeg-static": "^5.3.0",
    "lucide-react": "^0.470.0",
    "playwright": "^1.63.0",
    "png-to-ico": "^3.0.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.0.0",
    "remark-gfm": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  },
  "allowScripts": {
    "electron@39.8.10": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true,
    "ffmpeg-static@5.3.0": true
  }
}
